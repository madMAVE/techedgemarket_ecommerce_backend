# ─── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (Supabase Postgres) ───────────────────────
# Get your connection string from Supabase Dashboard → Settings → Database
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.xxx:yourpassword@aws-0-xxx.pooler.supabase.com:6543/postgres"

# ─── JWT Auth ────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://techedgemarket.in

# ─── File Uploads (Supabase Storage) ─────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBnd2tvZXBwcnVlcHBvYWpycnVnIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NTI1OTcxOCwiZXhwIjoyMTAwODM1NzE4fQ.yr9vkzrskWA6-91nvKkM_uvwK0ZnT0jKeEc5iSRJGhc
SUPABASE_STORAGE_BUCKET=tem_ecommerce_bucket
MAX_FILE_SIZE_MB=5

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── GST / India Specific ────────────────────────────────
GST_RATE=0.18
DEFAULT_CURRENCY=INR
COMPANY_GSTIN=36AABCT1234Z1Z5
